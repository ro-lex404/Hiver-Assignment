# ==============================================================================
# Environment Configuration for Hiver AI Support Agent
# ==============================================================================

# LLM API Keys (optional - system falls back to semantic rule & local generation if unset)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Kaggle Credentials (for automated dataset download & kernel sync)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# Model Configuration
PRIMARY_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2
JUDGE_MODEL=gemini-1.5-pro

# Pipeline Settings
TARGET_BRAND=AmazonHelp
TOP_K_RETRIEVAL=3
SIMILARITY_THRESHOLD=0.65
ESCALATION_CONFIDENCE_THRESHOLD=0.70
